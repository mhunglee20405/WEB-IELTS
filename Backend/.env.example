# ==============================
# Application
# ==============================
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# ==============================
# MongoDB
# ==============================
MONGODB_URI=mongodb://localhost:27017/ielts_lms?replicaSet=rs0

# ==============================
# Redis
# ==============================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==============================
# JWT
# ==============================
JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# ==============================
# SMTP / Mail
# ==============================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@example.com
SMTP_PASS=change_me_smtp_password
MAIL_FROM_NAME=IELTS LMS
MAIL_FROM_ADDRESS=no-reply@example.com

# ==============================
# File / S3-compatible storage
# ==============================
STORAGE_TYPE=disk
STORAGE_LOCAL_PATH=./uploads
# STORAGE_S3_ENDPOINT=https://s3.amazonaws.com
# STORAGE_S3_BUCKET=ielts-lms-bucket
# STORAGE_S3_REGION=ap-southeast-1
# STORAGE_S3_ACCESS_KEY=
# STORAGE_S3_SECRET_KEY=

# ==============================
# Seed
# ==============================
SEED_ADMIN_EMAIL=admin@ielts-lms.local
SEED_ADMIN_PASSWORD=Admin@123456
SEED_ADMIN_FULLNAME=System Admin

# ==============================
# CORS
# ==============================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

