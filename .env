# Local runtime validation environment (gitignored)
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1

MONGO_HOST_PORT=27018
MONGODB_URI=mongodb://localhost:27018/ielts_lms?replicaSet=rs0&directConnection=true

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_ACCESS_SECRET=local_dev_access_secret_at_least_32_characters_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=local_dev_refresh_secret_at_least_32_characters_long
JWT_REFRESH_EXPIRES_IN=7d

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@example.com
SMTP_PASS=local_dev_smtp_password
MAIL_FROM_NAME=IELTS LMS
MAIL_FROM_ADDRESS=no-reply@example.com

STORAGE_TYPE=disk
STORAGE_LOCAL_PATH=./uploads

SEED_ADMIN_EMAIL=admin@ielts-lms.local
SEED_ADMIN_PASSWORD=Admin@123456
SEED_ADMIN_FULLNAME=System Admin

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

