# ==============================================================================
# IELTS LMS Backend — Production Environment Variables Template
# ==============================================================================
# IMPORTANT:
# 1. Generate strong random secrets for all JWT secrets (minimum 64 characters recommended).
# 2. Never commit actual passwords, tokens, or private credentials to source control.
# 3. Restrict file permissions: chmod 600 .env.production
# ==============================================================================

NODE_ENV=production
PORT=3000
API_PREFIX=api/v1

# ------------------------------------------------------------------------------
# MongoDB Configuration (Replica Set required for transactions)
# ------------------------------------------------------------------------------
# Example for MongoDB Atlas or managed self-hosted replica set:
# MONGODB_URI=mongodb://<user>:<password>@mongo1:27017,mongo2:27017,mongo3:27017/ielts_lms?replicaSet=rs0&authSource=admin&ssl=true
MONGODB_URI=mongodb://ielts_user:REPLACE_WITH_SECURE_PASSWORD@mongodb:27017/ielts_lms?replicaSet=rs0&authSource=admin

# ------------------------------------------------------------------------------
# Redis Configuration (BullMQ Queues & Token Store)
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_SECURE_REDIS_PASSWORD

# ------------------------------------------------------------------------------
# Security & JWT Configuration (Argon2id + HMAC-SHA256)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=REPLACE_WITH_RANDOMLY_GENERATED_ACCESS_SECRET_MIN_32_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=REPLACE_WITH_RANDOMLY_GENERATED_REFRESH_SECRET_MIN_32_CHARS
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# SMTP Email Configuration (Outbox Worker)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=REPLACE_WITH_SMTP_PROVIDER_API_KEY
MAIL_FROM_NAME="IELTS Academic LMS"
MAIL_FROM_ADDRESS=noreply@ielts-lms.edu.vn

# ------------------------------------------------------------------------------
# Object Storage (Passage Audio & Attachments)
# ------------------------------------------------------------------------------
STORAGE_TYPE=disk
STORAGE_LOCAL_PATH=/app/uploads

# ------------------------------------------------------------------------------
# Initial Seed Administrator
# ------------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@ielts-lms.edu.vn
SEED_ADMIN_PASSWORD=REPLACE_WITH_INITIAL_STRONG_ADMIN_PASSWORD
SEED_ADMIN_FULLNAME="System Administrator"

# ------------------------------------------------------------------------------
# CORS Allowed Origins (Comma-separated for Next.js frontend)
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://lms.ielts-lms.edu.vn,https://admin.ielts-lms.edu.vn

# ------------------------------------------------------------------------------
# Observability & Health Thresholds
# ------------------------------------------------------------------------------
HEALTH_HEAP_THRESHOLD_MB=768

