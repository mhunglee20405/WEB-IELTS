# Public API base URL (must include /api/v1 prefix)
# Backend NestJS default port is 3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# API adapter mode: "live" (real backend REST calls) or "mock" (dev-only in-memory adapter)
NEXT_PUBLIC_API_MODE=live

# Default operational timezone for calendar, daily windows (00:00-23:59), and deadline checks
NEXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh

# Next.js Internal proxy rewrite destination for live backend
BACKEND_INTERNAL_URL=http://localhost:3000

